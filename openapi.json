{
  "openapi": "3.0.0",
  "info": {
    "title": "Task & Auth API",
    "version": "1.0.0",
    "description": "A RESTful Task CRUD API with Supabase Authentication and JWT Bearer protection."
  },
  "servers": [
    {
      "url": "http://localhost:3000",
      "description": "Local Development Server"
    }
  ],
  "components": {
    "securitySchemes": {
      "bearerAuth": {
        "type": "http",
        "scheme": "bearer",
        "bearerFormat": "JWT"
      }
    }
  },
  "paths": {
    "/": {
      "get": {
        "summary": "Get API Metadata",
        "description": "Returns basic information about the API and available endpoints.",
        "responses": {
          "200": {
            "description": "API metadata retrieved successfully"
          }
        }
      }
    },
    "/health": {
      "get": {
        "summary": "Health Check",
        "description": "Returns status of server and database connection.",
        "responses": {
          "200": {
            "description": "Server is healthy and DB is connected"
          }
        }
      }
    },
    "/auth/signup": {
      "post": {
        "summary": "User Registration",
        "description": "Registers a new user account with Supabase Auth using email and password.",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": ["email", "password"],
                "properties": {
                  "email": {
                    "type": "string",
                    "example": "testuser@example.com"
                  },
                  "password": {
                    "type": "string",
                    "example": "securepassword123"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "User created successfully"
          },
          "400": {
            "description": "Missing email/password or registration error"
          }
        }
      }
    },
    "/auth/login": {
      "post": {
        "summary": "User Login",
        "description": "Authenticates user with Supabase Auth and returns JWT access and refresh tokens.",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": ["email", "password"],
                "properties": {
                  "email": {
                    "type": "string",
                    "example": "testuser@example.com"
                  },
                  "password": {
                    "type": "string",
                    "example": "securepassword123"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Login successful (returns access_token and refresh_token)"
          },
          "400": {
            "description": "Missing email or password"
          },
          "401": {
            "description": "Invalid login credentials"
          }
        }
      }
    },
    "/auth/logout": {
      "post": {
        "summary": "User Logout",
        "description": "Ends user session (Requires Bearer token).",
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "responses": {
          "204": {
            "description": "Logout successful (No Content)"
          },
          "401": {
            "description": "Missing, invalid, or expired token"
          }
        }
      }
    },
    "/public/info": {
      "get": {
        "summary": "Public Information Endpoint",
        "description": "Publicly accessible endpoint returning open message.",
        "responses": {
          "200": {
            "description": "Public data retrieved successfully"
          }
        }
      }
    },
    "/protected/profile": {
      "get": {
        "summary": "Protected User Profile",
        "description": "Retrieves authenticated user profile metadata (Requires Bearer JWT token).",
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "responses": {
          "200": {
            "description": "Profile data retrieved successfully"
          },
          "401": {
            "description": "Missing, invalid, or expired token"
          }
        }
      }
    },
    "/protected/dashboard": {
      "get": {
        "summary": "Protected User Dashboard",
        "description": "Retrieves authenticated user dashboard metadata (Requires Bearer JWT token).",
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "responses": {
          "200": {
            "description": "Dashboard data retrieved successfully"
          },
          "401": {
            "description": "Missing, invalid, or expired token"
          }
        }
      }
    },
    "/tasks": {
      "get": {
        "summary": "Get All Tasks",
        "description": "Retrieves all tasks stored in PostgreSQL database.",
        "responses": {
          "200": {
            "description": "List of tasks"
          }
        }
      },
      "post": {
        "summary": "Create a New Task",
        "description": "Creates a new task in PostgreSQL.",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": ["title"],
                "properties": {
                  "title": {
                    "type": "string",
                    "example": "Learn Supabase Auth"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Task created successfully"
          },
          "400": {
            "description": "Invalid input / missing title"
          }
        }
      }
    },
    "/tasks/{id}": {
      "get": {
        "summary": "Get Task by ID",
        "description": "Retrieves task details by unique ID.",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Task details"
          },
          "404": {
            "description": "Task not found"
          }
        }
      },
      "put": {
        "summary": "Update a Task",
        "description": "Updates task title or done status.",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "title": {
                    "type": "string",
                    "example": "Learn Supabase Auth & JWT"
                  },
                  "done": {
                    "type": "boolean",
                    "example": true
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Task updated"
          },
          "400": {
            "description": "Invalid input"
          },
          "404": {
            "description": "Task not found"
          }
        }
      },
      "delete": {
        "summary": "Delete a Task",
        "description": "Deletes a task by ID.",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer"
            }
          }
        ],
        "responses": {
          "204": {
            "description": "Task deleted (No Content)"
          },
          "404": {
            "description": "Task not found"
          }
        }
      }
    }
  }
}
